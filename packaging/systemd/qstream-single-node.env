# QuantaStream single-node systemd environment template.
# Copy to /etc/quantastream/qstream-single-node.env and adjust paths before use.

QSTREAM_CONFIG_DIR=/etc/quantastream/configuration
QSTREAM_DATA_DIR=/var/lib/quantastream
QSTREAM_WAL_PATH=/var/lib/quantastream/storage.wal

QSTREAM_BIND=127.0.0.1
QSTREAM_MYSQL_PORT=4000
QSTREAM_NATIVE_GRPC_BIND=127.0.0.1
QSTREAM_NATIVE_GRPC_PORT=4100
QSTREAM_DATABASE=quanta

QSTREAM_AUTH_ACCOUNT_FILE=/etc/quantastream/accounts.yaml
QSTREAM_ACCESS_POLICY_FILE=/etc/quantastream/access-policy.yaml
