# Copy to quantastream-aws.env on bench-runner and edit for the active AWS fleet.

QS_REPO_DIR=/home/ubuntu/quantastream
QS_SSH_USER=ubuntu
QS_SSH_OPTS="-o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10"
# Optional when running ops from a workstation instead of bench-runner.
# QS_SSH_IDENTITY_FILE=~/.ssh/quantastream-benchmark-20260808.pem
# QS_SSH_BASTION_HOST=<bench-runner-public-ip>
# QS_SSH_BASTION_USER=ubuntu

# Consul server / MySQL proxy host.
QS_BENCH_HOST=127.0.0.1
QS_CONSUL_ENDPOINT=127.0.0.1:8500
# Consul endpoint used by quantastream-node processes on QS servers. Leave this
# as localhost when each QS server runs a local Consul client. Set it to the
# bench-runner private address, for example 172.31.14.139:8500, when QS servers
# should not auto-start or depend on local consul.service.
QS_NODE_CONSUL_ENDPOINT=127.0.0.1:8500
QS_NODE_REQUIRE_LOCAL_CONSUL=auto

# Distributed data nodes. Use private DNS names or private IPs reachable from
# bench-runner. Add two more entries here when moving from 3 to 5 nodes.
QS_NODE_HOSTS=(
  172.31.7.21
  172.31.13.55
  172.31.4.204
)

# Stable Quanta hash keys for those nodes, same order as QS_NODE_HOSTS.
QS_NODE_KEYS=(
  qs-server-1
  qs-server-2
  qs-server-3
)

QS_CLUSTER_SIZE=${QS_CLUSTER_SIZE:-${#QS_NODE_HOSTS[@]}}
QS_NODE_PORT=4400
QS_PROXY_MYSQL_PORT=4000
QS_NODE_DATA_DIR=/home/ubuntu/quantastream/tpc-h-benchmark/local/distributed-data
QS_SKIP_NODE_SYNC=1
QS_GRAPH_EQUALITY_ROLE_SEED=0
QS_SCHEMA_DIR=/home/ubuntu/quantastream/tpc-h-benchmark/config
QS_DATABASE=quanta

# TPC-H load/benchmark defaults for current AWS work.
QS_TPCH_DATA_DIR=/home/ubuntu/quantastream/tpc-h-benchmark/local/data/sf-0.05
QS_TPCH_LOAD_WORKERS=3
QS_TPCH_LOAD_BATCH_SIZE=1000
QS_BENCHMARK_RUNS=3
QS_BENCHMARK_WARMUP=1
